# Copiar a .env (local) o pegar estas variables en Coolify -> Environment Variables.
# NUNCA subir el .env real al repositorio.

# ---- Base de datos ----
POSTGRES_USER=postgres
POSTGRES_DB=inventario_ti
# Generar una contraseña larga:  openssl rand -hex 24
POSTGRES_PASSWORD=cambiar-esta-clave

# ---- Backend ----
# Generar un secreto largo:  openssl rand -base64 48
JWT_SECRET=cambiar-este-secreto

# Corre el seed de datos de ejemplo al arrancar (admin@ti.com / admin123).
# Es idempotente: si ya hay un técnico creado, no hace nada.
# Poner en false cuando el sistema ya tenga datos reales.
SEED_ON_START=true

# TypeORM sincroniza el esquema automáticamente. Dejar en true para el MVP.
DB_SYNCHRONIZE=true

# ---- Frontend ----
# /api = nginx hace de proxy al backend en el mismo dominio (recomendado).
# Cambiar sólo si el backend se publica en un dominio aparte.
VITE_API_URL=/api
