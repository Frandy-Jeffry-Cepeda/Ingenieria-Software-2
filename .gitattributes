# Auto detect text files and perform LF normalization
* text=auto

# Los scripts de shell y los ganchos de Git deben conservar finales de línea
# de Unix, o Git Bash no los ejecuta en Windows.
*.sh        text eol=lf
pre-push    text eol=lf

# Archivos que se usan dentro de los contenedores Linux del despliegue (Coolify): siempre LF.
Dockerfile           text eol=lf
*.template           text eol=lf

*.png binary
*.jpg binary
*.pdf binary
